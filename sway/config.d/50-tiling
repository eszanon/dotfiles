# Translation of Omarchy default/hypr/bindings/tiling-v2.conf
# Keycodes match Hyprland's code: bindings (10-19 = 1..0, 20 = -, 21 = =, 61 = /)
# so they keep working when switching br/us layouts.

# Close windows
bindsym $mod+w kill
bindsym $mod+q kill
bindsym Ctrl+Alt+Delete exec $bin/window-close-all

# Control tiling
bindsym $mod+j layout toggle split
bindsym $mod+t floating toggle
bindsym $mod+f fullscreen toggle
# No "full width" (maximized) state in sway; SUPER+ALT+F omitted
bindsym $mod+o floating enable; sticky enable
bindsym $mod+l layout toggle splith splitv tabbed
# SUPER+P (pseudo window) has no sway equivalent

# Move focus with SUPER + arrow keys
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

# Switch workspaces with SUPER + [1-9; 0]
bindcode $mod+10 workspace number 1
bindcode $mod+11 workspace number 2
bindcode $mod+12 workspace number 3
bindcode $mod+13 workspace number 4
bindcode $mod+14 workspace number 5
bindcode $mod+15 workspace number 6
bindcode $mod+16 workspace number 7
bindcode $mod+17 workspace number 8
bindcode $mod+18 workspace number 9
bindcode $mod+19 workspace number 10

# Move active window to a workspace (and follow it, like Hyprland movetoworkspace)
bindcode $mod+Shift+10 move container to workspace number 1; workspace number 1
bindcode $mod+Shift+11 move container to workspace number 2; workspace number 2
bindcode $mod+Shift+12 move container to workspace number 3; workspace number 3
bindcode $mod+Shift+13 move container to workspace number 4; workspace number 4
bindcode $mod+Shift+14 move container to workspace number 5; workspace number 5
bindcode $mod+Shift+15 move container to workspace number 6; workspace number 6
bindcode $mod+Shift+16 move container to workspace number 7; workspace number 7
bindcode $mod+Shift+17 move container to workspace number 8; workspace number 8
bindcode $mod+Shift+18 move container to workspace number 9; workspace number 9
bindcode $mod+Shift+19 move container to workspace number 10; workspace number 10

# Move active window silently (movetoworkspacesilent)
bindcode $mod+Shift+Alt+10 move container to workspace number 1
bindcode $mod+Shift+Alt+11 move container to workspace number 2
bindcode $mod+Shift+Alt+12 move container to workspace number 3
bindcode $mod+Shift+Alt+13 move container to workspace number 4
bindcode $mod+Shift+Alt+14 move container to workspace number 5
bindcode $mod+Shift+Alt+15 move container to workspace number 6
bindcode $mod+Shift+Alt+16 move container to workspace number 7
bindcode $mod+Shift+Alt+17 move container to workspace number 8
bindcode $mod+Shift+Alt+18 move container to workspace number 9
bindcode $mod+Shift+Alt+19 move container to workspace number 10

# Scratchpad: $mod+s toggles the quake terminal (bin/scratch-terminal),
# $mod+Alt+s hides the focused window into the scratchpad, $mod+Ctrl+s cycles those
bindsym $mod+s exec $bin/scratch-terminal
bindsym $mod+Alt+s move scratchpad
bindsym $mod+Ctrl+s scratchpad show

# Pressing the current workspace's number again jumps back to the previous one
workspace_auto_back_and_forth yes

# TAB between workspaces
bindsym $mod+Tab workspace next_on_output
bindsym $mod+Shift+Tab workspace prev_on_output
bindsym $mod+Ctrl+Tab workspace back_and_forth

# Move workspaces to other monitors
bindsym $mod+Shift+Alt+Left move workspace to output left
bindsym $mod+Shift+Alt+Right move workspace to output right
bindsym $mod+Shift+Alt+Up move workspace to output up
bindsym $mod+Shift+Alt+Down move workspace to output down

# Swap active window with the one next to it
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down

# Cycle through applications on active workspace
bindsym Alt+Tab exec $bin/window-cycle
bindsym Alt+Shift+Tab exec $bin/window-cycle prev

# Cycle through monitors
bindsym Ctrl+Alt+Tab focus output right
bindsym Ctrl+Alt+Shift+Tab focus output left

# Resize active window (- and = keys)
bindcode $mod+20 resize shrink width 100px
bindcode $mod+21 resize grow width 100px
bindcode $mod+Shift+20 resize shrink height 100px
bindcode $mod+Shift+21 resize grow height 100px

# Scroll through workspaces with SUPER + scroll
bindsym --whole-window $mod+button5 workspace next_on_output
bindsym --whole-window $mod+button4 workspace prev_on_output

# Groups (Hyprland togglegroup ~= tabbed container)
bindsym $mod+g layout toggle tabbed split
bindsym $mod+Alt+Tab focus next sibling
bindsym $mod+Alt+Shift+Tab focus prev sibling
bindsym $mod+Ctrl+Left focus prev sibling
bindsym $mod+Ctrl+Right focus next sibling
# moveintogroup / moveoutofgroup by direction have no sway equivalent

# Cycle monitor scaling with SUPER + /
bindcode $mod+61 exec $bin/monitor-scaling-cycle
bindcode $mod+Alt+61 exec $bin/monitor-scaling-cycle --reverse
