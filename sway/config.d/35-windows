# Window rules

# Don't let swayidle lock/blank the screen over fullscreen video or presentations
for_window [app_id=".*"] inhibit_idle fullscreen
for_window [class=".*"] inhibit_idle fullscreen

# Utility windows float
for_window [app_id="org.gnome.Calculator"] floating enable
for_window [app_id="nm-connection-editor"] floating enable
for_window [app_id="blueman-manager"] floating enable
for_window [app_id="pavucontrol"] floating enable
# TUIs spawned by launch-tui (wiremix, bluetui, nmtui, btop) float like on Omarchy
for_window [app_id="^org\.omarchy\."] floating enable
# btop (waybar cpu/memory click, $mod+Shift+t) needs room for its panels: fill most of the screen, centered
for_window [app_id="^org\.omarchy\.btop$"] resize set 85 ppt 85 ppt, move position center
# Disposable floating shell ($mod+Shift+p): roomy and centered
for_window [app_id="^org\.omarchy\.zsh$"] resize set 65 ppt 65 ppt, move position center
# Quake terminal ($mod+s, bin/scratch-terminal): dropdown across the top half, parked in the scratchpad
for_window [app_id="^scratch-term$"] floating enable, move scratchpad, scratchpad show, resize set 100 ppt 50 ppt, move position 0 0
