# Window rules

# Don't let swayidle lock/blank the screen over fullscreen video or presentations
for_window [app_id=".*"] inhibit_idle fullscreen
for_window [class=".*"] inhibit_idle fullscreen

# Utility windows float
for_window [app_id="org.gnome.Calculator"] floating enable
for_window [app_id="nm-connection-editor"] floating enable
for_window [app_id="blueman-manager"] floating enable
for_window [app_id="pavucontrol"] floating enable
# TUIs spawned by launch-tui (wiremix, bluetui, nmtui, btop) float like on Omarchy
for_window [app_id="^org\.omarchy\."] floating enable
