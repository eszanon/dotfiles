#!/bin/bash
# Port of omarchy-toggle-nightlight (hyprsunset -> wlsunset)
if pgrep -x wlsunset >/dev/null; then
  pkill -x wlsunset
  notify-send -u low "  Daylight screen temperature"
else
  setsid -f wlsunset -t 4000 -T 6500 >/dev/null 2>&1
  notify-send -u low "  Nightlight screen temperature"
fi
