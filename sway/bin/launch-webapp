#!/bin/bash
# Port of omarchy-launch-webapp: open a URL as a chromium-style app window.
browser=$(xdg-settings get default-web-browser 2>/dev/null)
case $browser in
google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | chromium*) ;;
*) browser="google-chrome.desktop" ;;
esac
browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' ~/.local/share/applications/$browser /usr/share/applications/$browser 2>/dev/null | head -1)
setsid -f "${browser_exec:-google-chrome}" --app="$1" "${@:2}" >/dev/null 2>&1
