# See https://git-scm.com/docs/git-config

[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
[init]
	defaultBranch = master
[pull]
  rebase = true

[submodule]
  fetchJobs = 16

[color "branch"]
  current  = magenta
  remote   = yellow
  upstream = green
  plain    = blue	

[editor]
  command = code --wait

[user]
	name = everton.zanon
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential

[push]
	autoSetupRemote = true

# Work identity/hosts (private submodule); silently ignored when absent.
[include]
	path = ~/.config/work/git/config
