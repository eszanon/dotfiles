	email = everton.zanon@magalu.cloud
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential

[url "https://everton.zanon@git.mgc.internal/"]
	insteadOf = https://git.mgc.internal/
[push]
	autoSetupRemote = true
